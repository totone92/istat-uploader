{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--categoryExtensions",
        "--no-usage-statistics",
        "--headless",
        "--executablePath=/snap/bin/chromium",
        "--userDataDir=/home/marco/lab/istat-uploader/dist/profilo-prove",
        "--viewport=1280x800",
        "--chromeArg=--host-resolver-rules=MAP turismatica.regione.umbria.it 127.0.0.1:18443, MAP *.umbriaround.it 127.0.0.1:18443, MAP male.example 127.0.0.1:18443, MAP * ~NOTFOUND, EXCLUDE 127.0.0.1",
        "--chromeArg=--ignore-certificate-errors",
        "--chromeArg=--no-sandbox"
      ]
    }
  }
}
